{
  "brackets": [["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "„", "close": "”", "notIn": ["string"] },
    { "open": "«", "close": "»", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["„", "”"], ["«", "»"], ["\"", "\""]],
  "onEnterRules": [
    {
      "beforeText": ":\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[\\p{L}\\p{N}]+"
}
